# Placeholders only. Real values go in .env.local at the repo root (git-ignored); never commit them.
# AWS credentials may instead come from the standard chain (AWS_PROFILE, an IAM role).

S3_BUCKET=your-bucket-name
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional overrides (defaults shown)
# UPLOAD_URL_TTL_SECONDS=300
# DOWNLOAD_URL_TTL_SECONDS=300
# MAX_UPLOAD_BYTES=26214400
# S3_ENDPOINT_URL=

# Browser origins allowed to call the API (comma-separated, exact match, no "*").
# Add the deployed frontend origin here, e.g. http://localhost:3000,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
